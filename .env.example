# PlayMaker JO Production Environment Variables
# Copy this to .env on the server and fill in real values.
# NEVER commit the .env file to git!

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_random_password
# App DB user — generate with: openssl rand -base64 32
MYSQL_APP_PASSWORD=CHANGE_ME_strong_random_password

# JWT — generate with: openssl rand -base64 48
# The API refuses to start in production while this still contains a placeholder word.
JWT_SECRET_KEY=CHANGE_ME_min_32_chars_random_key

# URLs
UPLOADS_BASE_URL=https://api.playmakerjo.com
# The website must be listed too: its sign-up forms call the API from the browser.
CORS_ORIGINS=https://admin.playmakerjo.com,https://playmakerjo.com,https://www.playmakerjo.com

# Google Sign-In — Web client ID from Firebase Console
# (Project settings → General → Web API / Client ID ending in .apps.googleusercontent.com)
GOOGLE_WEB_CLIENT_ID=

# Unpaid app bookings: release the slot when the player has not uploaded a CliQ proof in time.
# Counter bookings, series and anything already (partly) paid are never touched.
BOOKING_EXPIRY_ENABLED=true
# Minutes a player has to pay; shortened automatically for slots that start sooner.
BOOKING_EXPIRY_WINDOW_MINUTES=30
